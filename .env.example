# Copy to .env for local administration. Never commit .env.
AWS_REGION=
BAGGUARD_ENVIRONMENT=prod
BAGGUARD_RESOURCE_PREFIX=bagguard
BAGGUARD_CLICKHOUSE_DATABASE=bagguard
BAGGUARD_EVENT_STREAM_NAME=bagguard-baggage-events-prod
BAGGUARD_INCIDENT_STREAM_NAME=bagguard-risk-incidents-prod
BAGGUARD_AGENTCORE_RUNTIME_ID=
BAGGUARD_MODEL_ID=global.amazon.nova-2-lite-v1:0
BAGGUARD_CLICKHOUSE_ADAPTER_FUNCTION_NAME=bagguard-clickhouse-adapter-prod
BAGGUARD_LOG_LEVEL=INFO
